#!/bin/bash
# First-boot bootstrap for the Punjaber Lightsail instance.
#
# cloud-init runs this exactly once, on the instance's first boot — it tracks
# that it already ran for this instance ID and skips it on every reboot after.
# So changing an SSM value later and rebooting does nothing; see DEPLOYMENT.md
# for how to update a running instance.
#
# Everything it does is logged to /var/log/punjaber-bootstrap.log.

# Lightsail's launch-script execution does not reliably honour the shebang —
# it has been observed running this under dash (/bin/sh), which has neither
# `set -o pipefail` nor `> >(...)` process substitution. Without this guard the
# script dies on the next two lines having installed nothing, and without even
# creating the log file that would tell you why. Same guard as valkvtrader's
# bootstrap. Only POSIX sh syntax above this point, so dash can parse it.
if [ -z "$BASH_VERSION" ]; then
  exec /bin/bash "$0" "$@"
fi

set -euxo pipefail
exec > >(tee -a /var/log/punjaber-bootstrap.log) 2>&1

echo "=== Punjaber bootstrap starting at $(date -Is) ==="
echo "Running under: $BASH_VERSION"

# --- Docker -----------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive

# Ubuntu runs unattended-upgrades on first boot, which holds the dpkg lock.
# With `set -e` a single collision would kill the whole bootstrap, so wait for
# the lock rather than racing it. apt 2.4 (22.04) supports this natively.
APT_OPTS="-o DPkg::Lock::Timeout=300"

apt-get $APT_OPTS update
apt-get $APT_OPTS install -y ca-certificates curl gnupg

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
  | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get $APT_OPTS update
apt-get $APT_OPTS install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

# --- Persistent disk at /data ------------------------------------------------
# Two things make the naive version of this wrong, and both were observed:
#
#   1. Terraform asks Lightsail to attach the disk at /dev/xvdf, but the guest
#      kernel names it whatever it likes. On the NVMe-backed blueprints this
#      bundle now uses, it appears as /dev/nvme1n1 and /dev/xvdf never exists.
#   2. Creating the instance and attaching the disk are separate API calls, so
#      the disk can still be attaching while this script runs, or fail to
#      attach entirely.
#
# So: discover the device instead of assuming its name, wait a while for it to
# turn up, and if it never does, carry on with /data on the root filesystem.
# A missing disk should cost persistence across instance replacement, not the
# entire site -- the previous version aborted here and left nothing running.

echo "Block devices at bootstrap:"
lsblk || true

find_data_disk() {
  # The disk carrying /, which is the one we must not touch.
  root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
  root_disk="$(lsblk -no pkname "$root_src" 2>/dev/null | head -1 || true)"

  for dev in $(lsblk -dno NAME,TYPE | awk '$2 == "disk" { print $1 }'); do
    [ "$dev" = "$root_disk" ] && continue
    # Anything already mounted from this disk is not ours to format.
    if [ -n "$(lsblk -no MOUNTPOINT "/dev/$dev" 2>/dev/null | tr -d ' \n')" ]; then
      continue
    fi
    echo "/dev/$dev"
    return 0
  done
  return 1
}

DATA_DEV=""
for i in $(seq 1 36); do
  DATA_DEV="$(find_data_disk || true)"
  [ -n "$DATA_DEV" ] && break
  echo "waiting for a data disk to attach ($i/36)..."
  sleep 5
done

mkdir -p /data

if [ -n "$DATA_DEV" ]; then
  echo "Using data disk: $DATA_DEV"
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    echo "No filesystem on $DATA_DEV - creating ext4 (first boot for this disk)."
    mkfs.ext4 -F "$DATA_DEV"
  fi
  # Mount by UUID: device names are not stable across reboots or blueprints,
  # which is the whole problem this section exists to work around.
  DATA_UUID="$(blkid -s UUID -o value "$DATA_DEV")"
  if ! grep -q "$DATA_UUID" /etc/fstab; then
    echo "UUID=$DATA_UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
  fi
  mount /data || mount -a || true
  echo "Mounted:"; findmnt /data || echo "  WARNING: /data did not mount"
else
  echo "WARNING: no separate data disk attached after three minutes."
  echo "Continuing with /data on the root filesystem so the site still comes up."
  echo "Progress and any new recordings will NOT survive replacing this instance."
  echo "Check the disk is attached: Lightsail console -> Storage."
fi

mkdir -p /data/recordings /data/audio
# The container runs as root, so this is belt and braces rather than required.
chmod 755 /data

# --- Application files -------------------------------------------------------
# No `docker login`: valkvlabs/punjaber is a public repository and pulls
# anonymously. If it is ever made private, a login has to go here and the
# credential plumbing has to come back — see the note at the end of main.tf.
mkdir -p /opt/punjaber

cat > /opt/punjaber/Caddyfile <<'CADDYFILE_EOF'
${caddyfile_content}
CADDYFILE_EOF

cat > /opt/punjaber/docker-compose.yml <<'COMPOSE_EOF'
${docker_compose_content}
COMPOSE_EOF

chmod 600 /opt/punjaber/docker-compose.yml

# --- Start -------------------------------------------------------------------
cd /opt/punjaber
docker compose pull
docker compose up -d

echo "=== Punjaber bootstrap finished at $(date -Is) ==="
echo "Containers:"
docker compose ps

# The app seeds its recordings onto /data on first start, so this should show
# a populated directory once the container is healthy.
sleep 15
# `set -x` expands the glob before running it, so `ls /data/recordings/*.webm`
# printed all 323 filenames into the log and buried everything else. find
# keeps the count without the wall of output.
echo "Recordings on the data volume: $(find /data/recordings -name '*.webm' 2>/dev/null | wc -l)"

echo ""
echo "If the site is not reachable by name, DNS is the first thing to check:"
echo "  the A record must point at this instance's static IP."
