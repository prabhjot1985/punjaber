# Learner progress, and the regenerable synthesis cache.
data/*.db
data/*.db-wal
data/*.db-shm
data/audio/

# Native-speaker recordings are deliberately NOT ignored: they are the one
# thing here that cannot be regenerated. If you would rather keep audio out of
# git, uncomment the line below and rely on "make recordings-backup" instead.
# data/recordings/

backups/
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Deployment notes: kept local on purpose, since they carry account-specific
# details (URLs, region choices, anything you jot down mid-deploy).
DEPLOYMENT.md

# Terraform. State can contain resource identifiers and is not something to
# publish; tfvars holds your own configuration.
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/crash.log
terraform/crash.*.log
terraform/.terraformrc
terraform/tfplan
