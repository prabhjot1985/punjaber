      "items": [
        {"id": "u9l3-01", "pa": "ਮੈਂ ਪੰਜਾਬੀ ਬੋਲਦਾ ਹਾਂ", "roman": "main panjabi bolda han", "en": "I speak Punjabi (male speaker)", "kind": "phrase"},
        {"id": "u9l3-02", "pa": "ਮੈਂ ਪੰਜਾਬੀ ਬੋਲਦੀ ਹਾਂ", "roman": "main panjabi boldi han", "en": "I speak Punjabi (female speaker)", "kind": "phrase"},
        {"id": "u9l3-03", "pa": "ਤੁਸੀਂ ਕਿੱਥੇ ਜਾਂਦੇ ਹੋ?", "roman": "tusin kitthe jande ho?", "en": "Where do you go?", "kind": "phrase"},
        {"id": "u9l3-04", "pa": "ਮੈਂ ਬਜ਼ਾਰ ਜਾਂਦਾ ਹਾਂ", "roman": "main bazar janda han", "en": "I go to the market", "kind": "phrase"},
        {"id": "u9l3-05", "pa": "ਉਹ ਚਾਹ ਪੀਂਦਾ ਹੈ", "roman": "uh chah pinda hai", "en": "He drinks tea", "kind": "phrase"},
        {"id": "u9l3-06", "pa": "ਅਸੀਂ ਪੰਜਾਬੀ ਸਿੱਖਦੇ ਹਾਂ", "roman": "asin panjabi sikhde han", "en": "We learn Punjabi", "kind": "phrase"},
        {"id": "u9l3-07", "pa": "ਮੈਂ ਨਹੀਂ ਜਾਂਦਾ", "roman": "main nahin janda", "en": "I don't go", "kind": "phrase"},
        {"id": "u9l3-08", "pa": "ਮੈਂ ਸਮਝਦਾ ਹਾਂ", "roman": "main samajhda han", "en": "I understand", "kind": "phrase"}
