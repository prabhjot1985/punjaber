      "items": [
        {"id": "u7l3-01", "pa": "ਇਹ ਕਿੰਨੇ ਦਾ ਹੈ?", "roman": "ih kinne da hai?", "en": "How much is this?", "kind": "phrase"},
        {"id": "u7l3-02", "pa": "ਮਹਿੰਗਾ", "roman": "mahinga", "en": "expensive", "kind": "word"},
        {"id": "u7l3-03", "pa": "ਸਸਤਾ", "roman": "sasta", "en": "cheap", "kind": "word"},
        {"id": "u7l3-04", "pa": "ਮੈਨੂੰ ਇਹ ਚਾਹੀਦਾ ਹੈ", "roman": "mainu ih chahida hai", "en": "I want this", "kind": "phrase"},
        {"id": "u7l3-05", "pa": "ਦਿਖਾਓ ਜੀ", "roman": "dikhao ji", "en": "Please show me", "kind": "phrase"},
