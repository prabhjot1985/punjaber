        {"id": "u7l3-07", "pa": "ਮੈਂ ਲੈ ਲਵਾਂਗਾ", "roman": "main lai lavanga", "en": "I'll take it", "kind": "phrase"},
        {"id": "u7l3-08", "pa": "ਨਹੀਂ ਚਾਹੀਦਾ", "roman": "nahin chahida", "en": "I don't want it", "kind": "phrase"}
      ],
      "dialogue": [
        {"speaker": "You", "pa": "ਜੀ, ਇਹ ਕਿੰਨੇ ਦਾ ਹੈ?", "roman": "ji, ih kinne da hai?", "en": "Excuse me, how much is this?"},
        {"speaker": "Seller", "pa": "ਪੰਜ ਸੌ ਰੁਪਏ।", "roman": "panj sau rupae.", "en": "Five hundred rupees."},
        {"speaker": "You", "pa": "ਬਹੁਤ ਮਹਿੰਗਾ ਹੈ! ਥੋੜ੍ਹਾ ਘੱਟ ਕਰੋ ਜੀ।", "roman": "bahut mahinga hai! thorha ghatt karo ji.", "en": "That's very expensive! Make it a little less."},
